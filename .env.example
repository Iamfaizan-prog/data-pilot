# Copy to .env and fill in values. Never commit .env.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5432/datapilot
ENABLE_SCHEDULER=1

# Cookies are Secure by default. Set this to 0 for local HTTP development.
# SESSION_COOKIE_SECURE=0

# Leave SMTP_HOST empty to write .eml files into outbox/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
